# SQLite works out of the box for local dev. For production, point this at
# Postgres (Neon, Supabase, Vercel Postgres, etc.) and set provider =
# "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Generate a real one with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Optional — enables live AI assistant answers. Falls back gracefully if unset.
OPENAI_API_KEY=""
